[Unit]
Description=NusaNexus Router - AI Model Router
After=network.target

[Service]
Type=simple
User=router
Group=router
WorkingDirectory=/opt/router
ExecStart=/opt/router/router serve --config /opt/router/config/config.yaml
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/router/data

# Resource limits
LimitNOFILE=65536

# Environment (used if config.yaml references ${SERVER_HOST} / ${SERVER_PORT})
Environment="SERVER_HOST=0.0.0.0"
Environment="SERVER_PORT=1988"

[Install]
WantedBy=multi-user.target
