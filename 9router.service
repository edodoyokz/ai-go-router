[Unit]
Description=9router-go - AI Model Router
After=network.target

[Service]
Type=simple
User=9router
Group=9router
WorkingDirectory=/opt/9router
ExecStart=/opt/9router/9router serve --config /opt/9router/config/config.yaml
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/9router/data

# Resource limits
LimitNOFILE=65536

# Environment
Environment="SERVER_HOST=0.0.0.0"
Environment="SERVER_PORT=20128"

[Install]
WantedBy=multi-user.target
